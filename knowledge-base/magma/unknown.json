    {
      "key_path": "magma.print-chunk",
      "chinese_entries": [
        {
          "term": "打印区块加载信息",
          "context": "是否在日志中打印区块加载/卸载的详细信息。排查区块问题时开启。",
          "source": "docs/server-cores/30-magma.md"
        }
      ]
    },
    {
      "key_path": "magma.target-tps",
      "chinese_entries": [
