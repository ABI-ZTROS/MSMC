        {
          "term": "实体激活范围总开关",
          "context": "是否启用实体激活范围机制（远离玩家的实体降低 tick 频率）。",
          "source": "docs/server-cores/30-magma.md"
        }
      ]
    },
    {
      "key_path": "magma.enable-asynchronous-chunk",
      "chinese_entries": [
        {
          "term": "异步区块加载",
          "context": "是否启用异步区块加载/生成。开启可显著减少主线程卡顿，提升玩家飞行/传送流畅度。",
          "source": "docs/server-cores/30-magma.md"
        }
      ]
