    {
      "key_path": "magma.enable-real-ticking-entities",
      "chinese_entries": [
        {
          "term": "真实 tick 实体",
          "context": "是否对所有实体保持真实 tick（原版行为）。关闭可省性能，但部分模组机器/农场可能失效。",
          "source": "docs/server-cores/30-magma.md"
        }
      ]
    },
    {
      "key_path": "magma.tick-skip",
