  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- 🌐 前端构建与资源集成                                       -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!--
    【兼容性说明】
    这里刻意不用 MSBuild 属性函数（$([System.IO.Path]::...) / $([System.IO.File]::Exists(...))）。
    原因：NuGet 在还原阶段的 MSBuild 静态评估引擎不支持完整的属性函数，
    会导致 NU1105（找不到项目信息），进而让 MSMC.Tests 的 ProjectReference 还原失败。
    因此这里全部改用原生 Exists('...') 条件 + 简单属性字符串拼接。
  -->
  <PropertyGroup>
    <!-- MSBuildProjectDirectory 即 MSMC.csproj 所在目录，前端项目在兄弟目录 ..\frontend -->
    <FrontendDir>$(MSBuildProjectDirectory)\..\frontend</FrontendDir>
  </PropertyGroup>

  <!-- 诊断输出：构建时在 VS 输出面板高亮显示前端路径，便于排错 -->
  <!-- 【关键修复】DiagnoseFrontendPaths 故意去掉 Condition 属性，强制每次构建都跑。
       因为静态 Condition="Exists('中文路径')" 在 MSBuild 静态评估中可能因为编码/转义
       解析错误而永远为 false，导致用户看不到诊断信息，排错无从下手。
       真正的存在性判断改在 Target 内部用 Message Condition 动态展示，
       这样无论路径中是否有中文/特殊字符/反斜杠数量不匹配都能正确输出。 -->
  <Target Name="DiagnoseFrontendPaths" BeforeTargets="PrepareForBuild">
    <Message Text="────────────────────────────────────────────────" Importance="high" />
    <Message Text="📍 前端诊断: FrontendDir = $(FrontendDir)" Importance="high" />
    <!-- 用 MSBuild 内建的静态评估 + 动态路径规范化两种方式同时展示，方便对比差异 -->
    <Message Condition="Exists('$(FrontendDir)\package.json')"
             Text="✅ 静态评估: 找到 package.json" Importance="high" />
    <Message Condition="!Exists('$(FrontendDir)\package.json')"
             Text="⚠️  静态评估: 未找到 package.json （路径: $(FrontendDir)\package.json）" Importance="high" />
    <Message Condition="Exists('$(FrontendDir)\dist\index.html')"
             Text="✅ 静态评估: 找到已构建的 dist\index.html" Importance="high" />
    <Message Condition="!Exists('$(FrontendDir)\dist\index.html')"
             Text="⚠️  静态评估: 未构建前端 dist\index.html" Importance="high" />
    <!-- 把 IntermediateOutputPath 也打印出来，zip 生成失败时直接去这个目录查 -->
    <Message Text="📍 中间输出目录(wwwroot.zip 会生成在这里): $(IntermediateOutputPath)" Importance="high" />
    <Message Text="────────────────────────────────────────────────" Importance="high" />
  </Target>

  <!-- 自动构建前端：仅当 package.json 存在 且 dist\index.html 不存在时触发 -->
  <Target Name="BuildFrontend" BeforeTargets="PrepareForBuild"
          Condition="Exists('$(FrontendDir)\package.json') And !Exists('$(FrontendDir)\dist\index.html')">
    <Message Text="🌐 检测到前端尚未构建，开始 npm install + npm run build..." Importance="high" />
    <Exec
      Command="npm.cmd install --prefix &quot;$(FrontendDir)&quot;"
      WorkingDirectory="$(FrontendDir)"
      ContinueOnError="false"
      EchoOff="false"
      StandardOutputImportance="high"
      StandardErrorImportance="high" />
    <Exec
      Command="npm.cmd run build --prefix &quot;$(FrontendDir)&quot;"
      WorkingDirectory="$(FrontendDir)"
      ContinueOnError="false"
      EchoOff="false"
      StandardOutputImportance="high"
      StandardErrorImportance="high" />
  </Target>

  <!-- 当 package.json 和 dist 都不存在时给出明确警告，而不是静默让用户看到桥接测试页 -->
  <Target Name="WarnFrontendMissing" BeforeTargets="PrepareForBuild">
    <Message Condition="!Exists('$(FrontendDir)\package.json') And !Exists('$(FrontendDir)\dist\index.html')"
             Text="⚠───────────────────────────────────────────────────────────────" Importance="high" />
    <Message Condition="!Exists('$(FrontendDir)\package.json') And !Exists('$(FrontendDir)\dist\index.html')"
             Text="⚠️  未找到前端源代码目录和已构建产物。" Importance="high" />
    <Message Condition="!Exists('$(FrontendDir)\package.json') And !Exists('$(FrontendDir)\dist\index.html')"
             Text="⚠️  预期目录: $(FrontendDir)" Importance="high" />
    <Message Condition="!Exists('$(FrontendDir)\package.json') And !Exists('$(FrontendDir)\dist\index.html')"
             Text="⚠️  运行时应用将显示 WebView2 桥接测试页（降级页）。" Importance="high" />
    <Message Condition="!Exists('$(FrontendDir)\package.json') And !Exists('$(FrontendDir)\dist\index.html')"
             Text="⚠───────────────────────────────────────────────────────────────" Importance="high" />
  </Target>

  <!-- ═══════════════════════════════════════════════════════════════
       PackFrontendToZip: 把前端 dist 打包成单个 zip 作为嵌入资源
       ═══════════════════════════════════════════════════════════════
       【关键修复 1】去掉 Target 级别 Condition！
       Exists('中文路径\index.html') 静态评估在中文路径下会偶发解析成 false，
       导致整个 Target 根本不执行（用户日志已证实嵌入资源只剩 MSMC.g.resources）。
       现在改成 Target 无条件进入，在内部做动态存在性判定。

       【关键修复 2】不再 PowerShell Exec！改用 MSBuild 内联 C# 任务 (RoslynCodeTaskFactory)。
       原因：XML Entity → cmd → PowerShell 三层引号/转义在中文路径下必然出错，
       之前就是因为 &quot;&quot; 被解成空字符串才报 MSB3073 exit code 1。
       内联 C# 用 .NET 原生 System.IO.Compression，路径字符串不经过任何 shell 转义，
       中文路径/空格路径/特殊字符路径全部正确。
  -->
  <UsingTask TaskName="ZipDirectoryContents" TaskFactory="CodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceDirectory ParameterType="System.String" Required="true" />
      <DestinationArchive ParameterType="System.String" Required="true" />
      <Overwrite ParameterType="System.Boolean" Required="false" />
      <!-- 输出参数：任务结束后可以拿到最终生成的 zip 大小，用于 MSBuild 日志展示 -->
      <ResultArchiveSize ParameterType="System.Int64" Output="true" />
      <FilesArchived ParameterType="System.Int32" Output="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="System.IO.Compression.FileSystem" />
      <Reference Include="System.IO.Compression" />
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs">
<![CDATA[
// ====== 参数校验 ======
if (string.IsNullOrWhiteSpace(SourceDirectory))
{
    Log.LogError("ZipDirectoryContents: SourceDirectory 不能为空");
    return false;
}
if (!Directory.Exists(SourceDirectory))
{
    Log.LogError("ZipDirectoryContents: 源目录不存在: {0}", SourceDirectory);
    return false;
}
if (string.IsNullOrWhiteSpace(DestinationArchive))
{
    Log.LogError("ZipDirectoryContents: DestinationArchive 不能为空");
    return false;
}

bool overwrite = OverwriteSpecified ? Overwrite : true;

// ====== 规范化路径 ======
string destDir = Path.GetDirectoryName(DestinationArchive);
if (!string.IsNullOrEmpty(destDir) && !Directory.Exists(destDir))
{
    Directory.CreateDirectory(destDir);
    Log.LogMessage(MessageImportance.High,
        "📦 [ZipTask] 创建目标目录: {0}", destDir);
}

if (File.Exists(DestinationArchive))
{
    if (overwrite)
    {
        try { File.Delete(DestinationArchive); }
        catch (Exception ex)
        {
            Log.LogError("ZipDirectoryContents: 删除旧 zip 失败 {0}: {1}",
                DestinationArchive, ex.Message);
            return false;
        }
    }
    else
    {
        Log.LogError("ZipDirectoryContents: 目标已存在且 Overwrite=false: {0}",
            DestinationArchive);
        return false;
    }
}

// ====== 递归获取文件 ======
string[] allFiles;
try
{
    allFiles = Directory.GetFiles(SourceDirectory, "*", SearchOption.AllDirectories);
}
catch (Exception ex)
{
    Log.LogError("ZipDirectoryContents: 枚举源目录文件失败 {0}: {1}",
        SourceDirectory, ex.Message);
    return false;
}

if (allFiles == null || allFiles.Length == 0)
{
    Log.LogWarning("ZipDirectoryContents: 源目录为空，生成的 zip 不包含任何文件: {0}",
        SourceDirectory);
    // 即使空也生成一个合法的空 zip（ZipArchive 开 Create 后 Dispose 就有 22 字节 zip）
}

int counter = 0;
try
{
    using (var fs = new FileStream(DestinationArchive, FileMode.CreateNew, FileAccess.Write, FileShare.None))
    using (var archive = new ZipArchive(fs, ZipArchiveMode.Create, leaveOpen: false))
    {
        int srcLen = SourceDirectory.TrimEnd(Path.DirectorySeparatorChar,
            Path.AltDirectorySeparatorChar).Length + 1;

        foreach (var file in (allFiles ?? Enumerable.Empty<string>()))
        {
            // 得到相对路径（压缩包里的 entry 名）
            string relative = file.Length > srcLen
                ? file.Substring(srcLen).Replace(Path.DirectorySeparatorChar, '/')
                : Path.GetFileName(file);

            if (string.IsNullOrEmpty(relative)) continue;

            try
            {
                var entry = archive.CreateEntry(relative, CompressionLevel.Optimal);
                entry.LastWriteTime = File.GetLastWriteTime(file);

                using (var entryStream = entry.Open())
                using (var srcStream = new FileStream(file, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
                {
                    srcStream.CopyTo(entryStream);
                }
                counter++;
            }
            catch (Exception inner)
            {
                // 单文件失败不阻断整个 zip，但打 error 日志方便定位
                Log.LogWarning("ZipDirectoryContents: 单文件添加失败，跳过: {0} -> {1} ({2})",
                    file, relative, inner.Message);
            }
        }
    }
}
catch (Exception ex)
{
    Log.LogError("ZipDirectoryContents: 创建 zip 失败 {0}: {1}", DestinationArchive, ex);
    if (File.Exists(DestinationArchive))
    {
        try { File.Delete(DestinationArchive); } catch { /* 忽略清理失败 */ }
    }
    return false;
}

// ====== 输出参数 ======
FilesArchived = counter;
var info = new FileInfo(DestinationArchive);
ResultArchiveSize = info.Exists ? info.Length : 0L;

Log.LogMessage(MessageImportance.High,
    "✅ [ZipTask] 完成: {0} 个文件 -> {1} ({2:N2} KB)",
    counter, DestinationArchive, ResultArchiveSize / 1024.0);

return true;
]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="PackFrontendToZip" BeforeTargets="BeforeResGen">
    <PropertyGroup>
      <!-- Target 内部二次规范化，避免静态评估阶段对中文路径字符串拼接的编码问题 -->
      <_FrontendIndex Condition="'$(_FrontendIndex)' == ''">$(FrontendDir)\dist\index.html</_FrontendIndex>
      <_FrontendZip   Condition="'$(_FrontendZip)'   == ''">$(IntermediateOutputPath)wwwroot.zip</_FrontendZip>
      <_FrontendDist  Condition="'$(_FrontendDist)'  == ''">$(FrontendDir)\dist</_FrontendDist>
    </PropertyGroup>

    <Message Text="📦 [PackFrontendToZip] 开始处理: dist=$(_FrontendDist)  zip=$(_FrontendZip)" Importance="high" />

    <!-- 动态存在性判定（Target 内部 Condition 走完整 MSBuild 引擎，稳定） -->
    <Message Condition="!Exists('$(_FrontendIndex)')"
             Text="⚠️  [PackFrontendToZip] 跳过：未找到 index.html（$(_FrontendIndex)）。请先执行前端构建。" Importance="high" />

    <!-- 只有当 dist\index.html 存在时才真正执行压缩 + 嵌入 -->
    <Delete Condition="Exists('$(_FrontendIndex)') And Exists('$(_FrontendZip)')"
            Files="$(_FrontendZip)" />

    <ZipDirectoryContents Condition="Exists('$(_FrontendIndex)')"
      SourceDirectory="$(_FrontendDist)"
      DestinationArchive="$(_FrontendZip)"
      Overwrite="true">
      <Output TaskParameter="FilesArchived" PropertyName="_ZipFileCount" />
      <Output TaskParameter="ResultArchiveSize" PropertyName="_ZipSizeBytes" />
    </ZipDirectoryContents>

    <ItemGroup Condition="Exists('$(_FrontendIndex)') And Exists('$(_FrontendZip)')">
      <EmbeddedResource Include="$(_FrontendZip)">
        <LogicalName>$(AssemblyName).wwwroot.zip</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <Message Condition="Exists('$(_FrontendIndex)') And Exists('$(_FrontendZip)')"
             Text="✅ [PackFrontendToZip] 完成: 已嵌入 $(AssemblyName).wwwroot.zip，文件数=$(_ZipFileCount)，大小=$(_ZipSizeBytes) 字节" Importance="high" />
    <Message Condition="Exists('$(_FrontendIndex)') And !Exists('$(_FrontendZip)')"
             Text="❌ [PackFrontendToZip] 失败: dist 存在但 zip 未生成，请检查上面 ZipTask 的 ERROR 日志" Importance="high" />
  </Target>

  <!-- 复制 wwwroot 文件夹到输出目录（开发模式热重载备用）
       【修复】同样移除顶级 Condition，在内部做动态存在性判断，避免中文路径下静态评估失败。 -->
  <Target Name="CopyFrontendToOutput" BeforeTargets="BeforeBuild">
    <ItemGroup Condition="Exists('$(FrontendDir)\dist\index.html')">
      <None
        Include="$(FrontendDir)\dist\**"
        CopyToOutputDirectory="PreserveNewest"
