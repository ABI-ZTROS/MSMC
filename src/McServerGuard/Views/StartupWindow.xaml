<Window x:Class="McServerGuard.Views.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="MSMC 启动中"
        Width="640" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource DeepBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Border x:Name="WindowBorder"
            Background="{DynamicResource DeepBackgroundBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="0"
            MouseLeftButtonDown="WindowBorder_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部 Logo 和标题 -->
            <Grid Grid.Row="0" Margin="0,36,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Logo 光晕用多层半透明 Ellipse 代替 BlurEffect -->
                <Grid Grid.Column="0" Margin="36,0,20,0" Width="64" Height="64" HorizontalAlignment="Center">
                    <Ellipse x:Name="LogoGlow" Width="72" Height="72" Fill="{DynamicResource NavItemSelectedBrush}" Opacity="0.08" />
                    <Ellipse Width="66" Height="66" Fill="{DynamicResource NavItemSelectedBrush}" Opacity="0.15" />
                    <Ellipse Width="64" Height="64" Fill="{DynamicResource NavItemSelectedBrush}" />
                    <iconPacks:PackIconFontAwesome6 Kind="ShieldHalvedSolid"
                                                    Width="32" Height="32"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="White" />
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,4,32,0">
                    <TextBlock Text="MSMC"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBlock Text="Minecraft 服务器管理控制台"
                               FontSize="13"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="VersionText"
                               Text="v1.0.0"
                               FontSize="11"
                               Foreground="{DynamicResource MaterialDesignCaptionTextBlock}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- 日志输出区 -->
            <Border Grid.Row="1"
                    Margin="32,0,32,28"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 日志头部 -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource DeepBackgroundBrush}"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <iconPacks:PackIconFontAwesome6 Kind="TerminalSolid"
                                                            Width="14" Height="14"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,0"
                                                            Foreground="{DynamicResource NavItemSelectedBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="启动日志"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}"
                                       VerticalAlignment="Center" />
                            <!-- 状态指示点去掉 BlurEffect，用简单 Ellipse + 透明度动画 -->
                            <Ellipse Grid.Column="2"
                                     x:Name="StatusDot"
                                     Width="8" Height="8"
                                     HorizontalAlignment="Right"
                                     Fill="{DynamicResource GaugeGreenBrush}" />
                        </Grid>
                    </Border>

                    <!-- 进度条（嵌入日志区域内） -->
                    <ProgressBar Grid.Row="1"
                                 x:Name="StartupProgressBar"
                                 Height="3"
                                 Margin="0,0,0,0"
                                 IsIndeterminate="False"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="{DynamicResource NavItemSelectedBrush}"
                                 Background="{DynamicResource DeepBackgroundBrush}"
                                 BorderThickness="0" />

                    <ScrollViewer Grid.Row="2"
                                  x:Name="LogScrollViewer"
                                  Padding="12,8"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent">
                        <ItemsControl x:Name="LogItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}"
                                               FontFamily="Consolas, monospace"
                                               FontSize="12"
                                               Foreground="{Binding ColorBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,1,0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 底部区域：仅失败时显示退出按钮 -->
            <Grid Grid.Row="2" Margin="32,0,32,28">
                <Button x:Name="CloseButton"
                        Width="100" Height="36"
                        Content="退出"
                        Visibility="Collapsed"
                        Click="CloseButton_Click"
                        Background="{DynamicResource DangerBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Padding="12,0,12,0"
                        HorizontalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
