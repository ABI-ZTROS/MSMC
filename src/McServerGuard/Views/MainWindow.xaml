<!-- 🏠 主窗口 —— McServerGuard 的大本营 -->
<!-- WebView2 重构版：标题栏 + WebView2 内容 + 状态栏 -->
<Window x:Class="McServerGuard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MSMC - Minecraft Server Management Console"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource MaterialDesignPaper}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource AppFontFamily}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/McServerGuard;component/Themes/AppResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- 📐 整体布局：自定义标题栏 + WebView2 + 底部状态栏            -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 🎨 自定义标题栏 -->
            <RowDefinition Height="*" />     <!-- 🌐 WebView2 内容区 -->
            <RowDefinition Height="Auto" />  <!-- 📊 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 🎨 自定义标题栏 —— 可拖动                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardSubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Height="40"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <iconPacks:PackIconFontAwesome6 Kind="ShieldSolid"
                                            Width="18" Height="18"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Foreground="{DynamicResource NavItemSelectedBrush}" />
                    <TextBlock Text="MSMC"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBlock Text="Minecraft Server Management Console"
                               FontSize="11"
                               Opacity="0.5"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="最小化">
                        <iconPacks:PackIconFontAwesome6 Kind="WindowMinimizeSolid" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MaximizeButton_Click"
                            ToolTip="最大化">
                        <iconPacks:PackIconFontAwesome6 x:Name="MaximizeIcon"
                                                Kind="WindowMaximizeSolid" Width="10" Height="10" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WindowCloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭">
                        <iconPacks:PackIconFontAwesome6 Kind="XmarkSolid" Width="12" Height="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 🌐 WebView2 —— 承载 Web UI                                 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <wv2:WebView2 Grid.Row="1"
                      x:Name="MainWebView"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 📊 底部状态栏                                               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <materialDesign:ColorZone Grid.Row="2"
                                  Mode="PrimaryDark"
                                  Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <iconPacks:PackIconFontAwesome6 Kind="CircleInfoSolid"
                                            Width="16" Height="16"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                </StackPanel>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal">
                    <iconPacks:PackIconFontAwesome6 Kind="ShieldSolid"
                                            Width="12" Height="12"
                                            VerticalAlignment="Center"
                                            Margin="0,0,4,0"
                                            Foreground="{DynamicResource GaugeGreenBrush}" />
                    <TextBlock Text="Web UI Mode"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource GaugeGreenBrush}"
                               Opacity="0.9" />
                </StackPanel>

                <TextBlock Grid.Column="4"
                           Text="{Binding CurrentTime}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Opacity="0.7"
                           Margin="12,0,0,0" />
            </Grid>
        </materialDesign:ColorZone>
    </Grid>

</Window>
